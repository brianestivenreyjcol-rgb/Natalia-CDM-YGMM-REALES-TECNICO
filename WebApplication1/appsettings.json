{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // BigQuery por ODBC (Simba ODBC Driver for Google BigQuery). BQCOL es el DSN de usuario de este equipo.
    // HTAPI_ActivationThreshold al máximo: los resultados bajan por la API REST y no por la Storage API (gRPC),
    // que a través del proxy falla a veces («Storage API Error: failed to connect to all addresses»).
    // Sin DSN: "Driver={Simba ODBC Driver for Google BigQuery};Catalog=<proyecto de facturación>;OAuthMechanism=...;SQLDialect=1"
    "BigQuery": "DSN=BQCOL;HTAPI_ActivationThreshold=2147483647",
    // SQL Server (Microsoft.Data.SqlClient). Ejemplo: "Server=SERVIDOR;Database=BASE;Integrated Security=True;TrustServerCertificate=True"
    "SqlServer": ""
  },
  "CuadroMando": {
    "DiasHistorico": 100,
    "MinutosActualizacion": 60,
    "SegundosEsperaConsulta": 600
  }
}
